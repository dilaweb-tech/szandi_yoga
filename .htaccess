# ==========================================================================
# Ügyféloldal – Apache konfiguráció
#
# A dokumentumgyökér MAGA ennek a repónak a klónja: statikus lap, nincs
# szerveroldali kód.
#
# HA FELTÖLTÉS UTÁN 500-AS HIBÁT AD A LAP: a tárhelyen `AllowOverride None`,
# tehát a .htaccess tiltott – töröld a fájlt a docrootból.
# ==========================================================================

# Ponttal kezdődő fájlok és mappák elzárása (.git, .claude, .env). A
# .well-known kivétel, különben a Let's Encrypt megújítás áll. 404 és nem 403,
# mert a 403 elárulná, hogy a fájl létezik.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Csak HTTPS. A proxy mögötti tárhely a sima HTTPS-változót nem látja,
    # ezért az X-Forwarded-Proto is számít – különben végtelen átirányítás.
    # A .well-known kivétel: a Let's Encrypt első ellenőrzése még HTTP-n jön.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteRule (^|/)\.(?!well-known) - [R=404,L]

    # ENGEDÉLYLISTA: csak a látogatónak szánt fájltípusok mennek ki, minden
    # más 404. A tiltólista mindig egy lépéssel le van maradva – a sablonon
    # 2026-08-27-ig emiatt volt letölthető egy belső jegyzet (.txt). Így az
    # ügyfél docrootjába tévedt jegyzet, ajánlat vagy tábla (.pdf, .docx,
    # .csv) alapból ZÁRT, nem kell minden új kiterjesztésre gondolni.
    #
    # A .json BENNE van: azt a site.js tölti be (site.json). A minta-oldalak
    # (peldak/) ettől függetlenül zárva maradnak, lásd lentebb.
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]+$
    RewriteCond %{REQUEST_URI} !\.(html|css|js|json|svg|png|jpe?g|webp|avif|ico|woff2)$ [NC]
    RewriteRule ^ - [R=404,L]
</IfModule>

# A .json engedélyezett (site.json), ezért a minta-oldalakat mappa szerint
# kell zárni – különben a fodrász oldala kiszolgálná az ügyvéd mintaadatait.
<IfModule mod_alias.c>
  # Belső mappák: a generáló eszközök, a minta-oldalak (másik szakma
  # adatai) és a gyertya Blender-forrása (szandi_gyertya: .blend, zip,
  # előnézet) nem az ügyfél látogatójának szólnak. A repóban maradnak.
  RedirectMatch 404 "(?i)^/(tools|peldak|szandi_gyertya)(/|$)"
</IfModule>

# Deploy után azonnal friss lap: a HTML, CSS, JS és JSON minden betöltésnél
# visszakérdez (ETag → 304, olcsó), így a telefon sem ragad a régi változaton.
# A képek egy óráig élnek – azonos néven cserélt fotó is legkésőbb ennyi után
# látszik. (A GitHub Pages ezt nem olvassa; ott a site.js checkFresh() dolgozik.)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "max-age=3600"
  </FilesMatch>
</IfModule>

# Biztonsági fejlécek. A tartalom-szabályt (CSP) a HTML-ek <meta>-ja adja,
# az a GitHub Pages-en is él; itt csak az kerül mellé, amit meta-ból nem lehet:
# keretbe ágyazás tiltása (clickjacking). A két CSP egyszerre érvényes.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
</IfModule>
ServerSignature Off

# Saját hibaoldal. A 404.html a `<base href="/">` miatt gyökérhez igazodva
# tölti a CSS-t és a site.json-t, tehát mély, nem létező úton is helyesen
# jelenik meg.
ErrorDocument 404 /404.html
